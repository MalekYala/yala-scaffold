# scaffold:env:start — generated by 'make env-example', do not edit by hand

# ── Service ───────────────────────────────────────────────────────────
# Port the service listens on inside the container.
PORT=<PORT>

# Bind address for a local, non-Docker run (defaults to 127.0.0.1). Leave it
# unset in Docker: the image binds 0.0.0.0 and the compose port mapping
# limits exposure to 127.0.0.1.
# HOST=127.0.0.1

# One of debug, info, warning, error, critical.
LOG_LEVEL=INFO

# Deployment environment name: development, staging, production.
ENV=development

# Build version, injected at image build time. Reported by /health.
APP_VERSION=0.0.0-dev

# ── Container ownership ───────────────────────────────────────────────
# Numeric UID the container runs as, so bind mounts stay writable.
HOST_UID=<HOST_UID>

# Numeric GID the container runs as.
HOST_GID=<HOST_GID>

# ── Optional integrations ─────────────────────────────────────────────
# PostgreSQL connection string.
# DATABASE_URL=

# Redis connection string.
# REDIS_URL=

# ── Upstream ──────────────────────────────────────────────────────────
# Base URL of the service this bridges. Required — a bridge with no upstream
# has nothing to do.
UPSTREAM_URL=http://127.0.0.1:9000

# Path on the upstream that /ready probes.
UPSTREAM_HEALTH_PATH=/health

# Credential sent upstream. Never echoed back to callers.
# UPSTREAM_TOKEN=

# Per-request timeout. Shorter than your caller's timeout, or you become the
# thing that times out.
UPSTREAM_TIMEOUT_S=30.0

# ── Circuit breaker ───────────────────────────────────────────────────
# Consecutive upstream failures before the circuit breaker opens. Without a
# breaker, one upstream outage becomes two: theirs, and the retry storm you
# add to it.
BREAKER_THRESHOLD=5

# Seconds the breaker stays open before letting one request through.
BREAKER_COOLDOWN_S=30.0

# scaffold:env:end
