# scaffold:env:start — generated by 'make env-example', do not edit by hand

# ── Service ───────────────────────────────────────────────────────────
# Port the service listens on inside the container.
PORT=<PORT>

# In-container bind address. The compose port mapping restricts host
# exposure to 127.0.0.1; do not set this to 127.0.0.1 in Docker or the
# service becomes unreachable through the mapping.
HOST=127.0.0.1

# One of debug, info, warning, error, critical.
LOG_LEVEL=INFO

# Deployment environment name: development, staging, production.
ENV=development

# Build version, injected at image build time. Reported by /health.
APP_VERSION=0.0.0-dev

# ── Container ownership ───────────────────────────────────────────────
# Numeric UID the container runs as, so bind mounts stay writable.
HOST_UID=<HOST_UID>

# Numeric GID the container runs as.
HOST_GID=<HOST_GID>

# ── Optional integrations ─────────────────────────────────────────────
# PostgreSQL connection string.
# DATABASE_URL=

# Redis connection string.
# REDIS_URL=

# ── Image limits ──────────────────────────────────────────────────────
# Largest upload accepted, in bytes. Rejected before the image is decoded,
# so an oversized file costs almost nothing.
MAX_UPLOAD_BYTES=10485760

# Pillow decompression-bomb guard: total pixels allowed after decoding. A
# small compressed file can still expand to gigabytes of bitmap.
MAX_IMAGE_PIXELS=20000000

# Longest edge of the returned image. Larger inputs are scaled down,
# bounding both response size and processing time.
MAX_OUTPUT_DIMENSION=2048

# scaffold:env:end
