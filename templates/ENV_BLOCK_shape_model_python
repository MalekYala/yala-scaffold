# scaffold:env:start — generated by 'make env-example', do not edit by hand

# ── Service ───────────────────────────────────────────────────────────
# Port the service listens on inside the container.
PORT=<PORT>

# In-container bind address. The compose port mapping restricts host
# exposure to 127.0.0.1; do not set this to 127.0.0.1 in Docker or the
# service becomes unreachable through the mapping.
HOST=127.0.0.1

# One of debug, info, warning, error, critical.
LOG_LEVEL=INFO

# Deployment environment name: development, staging, production.
ENV=development

# Build version, injected at image build time. Reported by /health.
APP_VERSION=0.0.0-dev

# ── Container ownership ───────────────────────────────────────────────
# Numeric UID the container runs as, so bind mounts stay writable.
HOST_UID=<HOST_UID>

# Numeric GID the container runs as.
HOST_GID=<HOST_GID>

# ── Optional integrations ─────────────────────────────────────────────
# PostgreSQL connection string.
# DATABASE_URL=

# Redis connection string.
# REDIS_URL=

# ── Model training ────────────────────────────────────────────────────
# Base model to fine-tune, as a HuggingFace repo id or a local path. The
# default is deliberately tiny so the pipeline runs end to end on modest
# hardware before you commit to something large.
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Host directory for base weights and the HuggingFace cache. Point this at a
# disk with room — base models reach tens of gigabytes.
MODEL_CACHE=./data

# GPUs to reserve for the train and serve services.
GPU_COUNT=1

# ── Evaluation ────────────────────────────────────────────────────────
# OpenAI-compatible endpoint the evaluator scores against. Evaluating a
# served model rather than a checkpoint is the point: it includes the
# serving stack, quantisation and sampling settings.
EVAL_BASE_URL=http://127.0.0.1:8000/v1

# Model name to request from that endpoint.
EVAL_MODEL=<name>

# Bearer token for the eval endpoint. Unset for a local vLLM server.
# EVAL_API_KEY=

# ── Serving ───────────────────────────────────────────────────────────
# Host port for the vLLM server. Bound to 127.0.0.1 only.
SERVE_PORT=8000

# scaffold:env:end
