# scaffold:env:start — generated by 'make env-example', do not edit by hand

# ── Service ───────────────────────────────────────────────────────────
# Port the service listens on inside the container.
PORT=<PORT>

# In-container bind address. The compose port mapping restricts host
# exposure to 127.0.0.1; do not set this to 127.0.0.1 in Docker or the
# service becomes unreachable through the mapping.
HOST=127.0.0.1

# One of debug, info, warning, error, critical.
LOG_LEVEL=INFO

# Deployment environment name: development, staging, production.
ENV=development

# Build version, injected at image build time. Reported by /health.
APP_VERSION=0.0.0-dev

# ── Container ownership ───────────────────────────────────────────────
# Numeric UID the container runs as, so bind mounts stay writable.
HOST_UID=<HOST_UID>

# Numeric GID the container runs as.
HOST_GID=<HOST_GID>

# ── Optional integrations ─────────────────────────────────────────────
# PostgreSQL connection string.
# DATABASE_URL=

# Redis connection string.
# REDIS_URL=

# ── Model ─────────────────────────────────────────────────────────────
# openai (including any OpenAI-compatible endpoint via MODEL_BASE_URL) or
# anthropic.
MODEL_PROVIDER=openai

# Model identifier as the provider names it.
MODEL_NAME=gpt-4o-mini

# OpenAI-compatible endpoint. Point this at a local vLLM or Ollama server to
# develop without spending anything or sending prompts off the machine.
MODEL_BASE_URL=

# Provider key. Prefer the Vault add-on over pasting it here.
# MODEL_API_KEY=

# 0 for reproducibility. An agent whose answers move between identical runs
# cannot be evaluated, only sampled.
MODEL_TEMPERATURE=0

# Per-request timeout in seconds.
MODEL_TIMEOUT_S=60

# ── Safety limits ─────────────────────────────────────────────────────
# Maximum graph steps per run. This is the backstop between a model that
# will not stop asking for tools and an unbounded bill.
RECURSION_LIMIT=25

# scaffold:env:end
