{
  "project": "<name>",
  "shape": "pipeline",
  "kpis": [
    {
      "name": "last_run_success",
      "kpi_type": "boolean",
      "unit": "bool",
      "direction": "higher",
      "target": 1,
      "interval_s": 300,
      "source": {
        "type": "shell",
        "cmd": "python3 -c \"import json; print(1 if json.load(open('outputs/manifest.json')).get('success') else 0)\" 2>/dev/null || echo 0"
      },
      "description": "Did the most recent pipeline run complete successfully?"
    },
    {
      "name": "final_row_count",
      "kpi_type": "gauge",
      "unit": "rows",
      "direction": "higher",
      "interval_s": 300,
      "source": {
        "type": "shell",
        "cmd": "python3 -c \"import json; print(json.load(open('outputs/manifest.json'))['final_output']['row_count'])\" 2>/dev/null || echo 0"
      },
      "description": "Row count of the final pipeline output"
    },
    {
      "name": "run_freshness_s",
      "kpi_type": "gauge",
      "unit": "seconds",
      "direction": "lower",
      "target": 86400,
      "interval_s": 300,
      "source": {
        "type": "shell",
        "cmd": "python3 -c \"import os, time; print(int(time.time() - os.path.getmtime('outputs/manifest.json')))\" 2>/dev/null || echo 999999"
      },
      "description": "Seconds since the last successful pipeline run"
    },
    {
      "name": "p99_stage_duration_ms",
      "kpi_type": "gauge",
      "unit": "ms",
      "direction": "lower",
      "interval_s": 300,
      "source": {
        "type": "metric_log_grep",
        "log_file": "logs/pipeline.log",
        "pattern": "phase=stage_.* duration_ms=(\\d+)",
        "window_s": 86400,
        "aggregate": "p99"
      },
      "description": "p99 stage duration across all runs in the last day"
    },
    {
      "name": "qa_score",
      "kpi_type": "float",
      "unit": "ratio",
      "direction": "higher",
      "target": 1.0,
      "interval_s": 300,
      "source": {
        "type": "shell",
        "cmd": "./metric.sh",
        "timeout_s": 60
      },
      "description": "qa_check.py pass ratio"
    }
  ]
}
