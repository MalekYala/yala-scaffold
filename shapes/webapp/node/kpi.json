{
  "project": "<name>",
  "shape": "webapp",
  "lang": "node",
  "kpis": [
    {
      "name": "health_up",
      "kpi_type": "boolean",
      "unit": "bool",
      "direction": "higher",
      "target": 1,
      "interval_s": 60,
      "source": {
        "type": "http_status",
        "url": "http://127.0.0.1:<PORT>/health",
        "expect_status": 200
      },
      "description": "Webapp server is responding on /health"
    },
    {
      "name": "health_latency_ms",
      "kpi_type": "gauge",
      "unit": "ms",
      "direction": "lower",
      "target": 100,
      "interval_s": 60,
      "source": {
        "type": "http_latency",
        "url": "http://127.0.0.1:<PORT>/health"
      },
      "description": "How fast /health responds"
    },
    {
      "name": "index_html_size_bytes",
      "kpi_type": "gauge",
      "unit": "bytes",
      "direction": "lower",
      "target": 102400,
      "interval_s": 300,
      "source": {
        "type": "shell",
        "cmd": "curl -s http://127.0.0.1:<PORT>/ | wc -c"
      },
      "description": "Size of the served index.html (watch for bundle bloat)"
    },
    {
      "name": "supported_locales",
      "kpi_type": "gauge",
      "unit": "count",
      "direction": "higher",
      "interval_s": 300,
      "source": {
        "type": "http_json",
        "url": "http://127.0.0.1:<PORT>/api/locales",
        "field": "available.length"
      },
      "description": "How many languages the webapp supports"
    },
    {
      "name": "qa_score",
      "kpi_type": "float",
      "unit": "ratio",
      "direction": "higher",
      "target": 1.0,
      "interval_s": 300,
      "source": {
        "type": "shell",
        "cmd": "./metric.sh",
        "timeout_s": 60
      },
      "description": "qa_check.js pass ratio"
    }
  ]
}
