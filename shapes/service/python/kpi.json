{
  "project": "<name>",
  "shape": "service",
  "kpis": [
    {
      "name": "health_up",
      "kpi_type": "boolean",
      "unit": "bool",
      "direction": "higher",
      "target": 1,
      "interval_s": 60,
      "source": {
        "type": "http_status",
        "url": "http://127.0.0.1:<PORT>/health",
        "expect_status": 200
      },
      "description": "Is the service responding on /health?"
    },
    {
      "name": "health_latency_ms",
      "kpi_type": "gauge",
      "unit": "ms",
      "direction": "lower",
      "target": 100,
      "interval_s": 60,
      "source": {
        "type": "http_latency",
        "url": "http://127.0.0.1:<PORT>/health"
      },
      "description": "How fast /health responds"
    },
    {
      "name": "qa_score",
      "kpi_type": "float",
      "unit": "ratio",
      "direction": "higher",
      "target": 1.0,
      "interval_s": 300,
      "source": {
        "type": "shell",
        "cmd": "./metric.sh",
        "timeout_s": 60
      },
      "description": "qa_check.py pass ratio (0.0–1.0)"
    }
  ]
}
